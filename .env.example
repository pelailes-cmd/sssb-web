# Supabase's project URL and publishable key are safe to use in a browser when RLS is enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The public login form uses usernames while Supabase Auth uses internal email aliases.
VITE_ADMIN_USERNAME=pelailes
VITE_ADMIN_AUTH_EMAIL=pelailes@admin.sssb.test
VITE_ADMIN_AUTH_DOMAIN=admin.sssb.test

# Google Apps Script web app that emails the short quote inquiry to the sales inbox.
# This address is public, like any endpoint a browser calls. The recipient mailbox is configured
# inside the script itself, not here. See EMAIL_SETUP.md.
VITE_QUOTE_INQUIRY_ENDPOINT=
