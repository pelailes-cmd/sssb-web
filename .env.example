# Supabase's project URL and publishable key are safe to use in a browser when RLS is enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The public login form uses usernames while Supabase Auth uses internal email aliases.
VITE_ADMIN_USERNAME=pelailes
VITE_ADMIN_AUTH_EMAIL=pelailes@admin.sssb.test
VITE_ADMIN_AUTH_DOMAIN=admin.sssb.test
